@page
@model PublicaSA.Website.Pages.Representantes.CrearModel
@{
    ViewData["Title"] = "Crear Representante";
    var erroresValidacion = !ViewData.ModelState.IsValid
        ? string.Join("<br/>", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))
        : null;
}

<!-- Encabezado -->
<div class="card border-0 shadow-sm mb-4 representantes-header-card">
    <div class="card-body py-3">
        <h1 class="h5 fw-bold mb-3">Nuevo Representante</h1>
        <!-- Botones circulares: Regresar / Guardar -->
        <div class="d-flex gap-2">
            <a asp-page="/Representantes/Index"
               class="btn btn-accion rounded-circle"
               aria-label="Regresar al listado"
               title="Regresar">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
            </a>
            <button type="submit"
                    form="formRepresentante"
                    class="btn btn-accion rounded-circle"
                    aria-label="Guardar representante"
                    title="Guardar">
                <i class="fas fa-save" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

<!-- Card del formulario -->
<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <!-- Título -->
        <div class="mb-4 pb-3 border-bottom">
            <h5 class="fw-bold mb-0 representantes-card-title">
                Formulario Representante
            </h5>
        </div>

        <form id="formRepresentante" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Nombre" class="form-label fw-bold mb-1 representantes-label">
                        Nombre <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Nombre" class="form-control" placeholder="Nombre completo del representante" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Email" class="form-label fw-bold mb-1 representantes-label">
                        Email <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Email" type="email" class="form-control" placeholder="correo@dominio.com" />
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Usamos el modal global definido en _Layout.cshtml -->

@section Scripts {
    <link rel="stylesheet" href="~/css/Representantes.css" asp-append-version="true" />

    @if (!string.IsNullOrEmpty(erroresValidacion))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarMensaje('Advertencia', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(erroresValidacion)));
            });
        </script>
    }
}
