@page
@model IndexModel
@{
    ViewData["Title"] = "Bienvenido";
}

<link rel="stylesheet" href="~/css/Index.css" asp-append-version="true" />

<section class="welcome-wrapper">
    <div class="welcome-card text-center">
        <div class="mb-4">
            <img src="~/images/logo.png" alt="Logo de Pública S.A." class="welcome-logo" />
        </div>
        <h1 class="welcome-title">
            Bienvenido(a), <span class="welcome-user">@Model.NombreCompleto</span>
        </h1>
    </div>
</section>
