@page
@model PublicaSA.Website.Pages.Login.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - Pública S.A.</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
</head>
<body class="login-body">

    <div class="login-box">
        <div class="text-center mb-4">
            <img src="~/images/logo.png" alt="Logo Pública S.A." class="login-logo" />
            <h1 class="login-brand">Pública S.A.</h1>
            <p class="text-muted mb-0">Iniciar sesión</p>
        </div>

        <form method="post">
            <div class="mb-3">
                <label for="Usuario" class="form-label">Usuario</label>
                <input type="text" class="form-control" id="Usuario" name="Usuario" maxlength="50" autocomplete="username" />
            </div>

            <div class="mb-4">
                <label for="Contrasena" class="form-label">Contraseña</label>
                <div class="input-group">
                    <input type="password" class="form-control" id="Contrasena" name="Contrasena" autocomplete="current-password" />
                    <button class="btn btn-outline-secondary" type="button" id="btnTogglePassword" title="Mostrar/Ocultar contraseña">
                        <i class="fas fa-eye" id="iconTogglePassword"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-aceptar">
                Aceptar
            </button>
        </form>

        <div class="alert alert-danger mt-3 mb-0 @(Model.MostrarError ? "" : "d-none")" role="alert" id="mensajeError">
            @Model.MensajeError
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Login.js" asp-append-version="true"></script>
</body>
</html>
