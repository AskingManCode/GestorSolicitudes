@page
@model PublicaSA.Website.Pages.Solicitudes.Tareas.NuevoModel
@{
    ViewData["Title"] = "Nueva Tarea";
}

<div class="tareas-page">
    <div class="card border-0 shadow-sm mb-4 hu-header-card">
        <div class="card-body py-3">
            <h1 class="h5 fw-bold mb-3">Nueva Tarea</h1>
            <div class="d-flex flex-wrap align-items-center gap-2 hu-header-actions">
                <a asp-page="./Index" asp-route-idSolicitud="@Model.IdSolicitud"
                   class="btn btn-sm btn-secondary">
                    <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>Regresar a Tareas
                </a>
                <span class="text-muted small ms-sm-2">Solicitud: @Model.IdSolicitud</span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h2 class="h5 fw-bold hu-card-title">Información de la Tarea</h2>
        </div>
        <div class="card-body p-4">
            <form method="post" class="hu-form">
                <input type="hidden" asp-for="IdSolicitud" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Entrada.Descripcion" class="form-label">
                            Descripción de la tarea <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Entrada.Descripcion" class="form-control" rows="3"
                                  placeholder="Ingrese la descripción de la tarea"></textarea>
                        <span asp-validation-for="Entrada.Descripcion" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Entrada.Fecha" class="form-label">
                            Fecha <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Entrada.Fecha" type="date" min="2000-01-01"
                               max="2150-12-31" class="form-control" />
                        <span asp-validation-for="Entrada.Fecha" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Entrada.IdUsuario" class="form-label">
                            Usuario <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Entrada.IdUsuario" asp-items="Model.Usuarios" class="form-select">
                            <option value="">Seleccione un usuario</option>
                        </select>
                        <span asp-validation-for="Entrada.IdUsuario" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Entrada.HorasInvertidas" class="form-label">
                            Horas invertidas <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Entrada.HorasInvertidas" type="number" step="0.01"
                               min="0.01" max="24" class="form-control" />
                        <span asp-validation-for="Entrada.HorasInvertidas" class="text-danger"></span>
                    </div>
                </div>
                <div class="d-flex flex-wrap justify-content-end gap-2 hu-form-footer">
                    <a asp-page="./Index" asp-route-idSolicitud="@Model.IdSolicitud" class="btn btn-secondary">
                        <i class="fas fa-times me-1" aria-hidden="true"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-hu-primary">
                        <i class="fas fa-save me-1" aria-hidden="true"></i>Guardar Tarea
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Tareas.css" asp-append-version="true" />
    <partial name="_ValidationScriptsPartial" />
}
