@page
@model PublicaSA.Website.Pages.Solicitudes.IndexModel
@{
    ViewData["Title"] = "Solicitudes";
}

<!-- Bloque superior con borde azul -->
<div class="card border-0 shadow-sm mb-4 solicitudes-header-card">
    <div class="card-body py-3">
        <h1 class="h5 fw-bold mb-3">
            Mantenimiento de Solicitudes
        </h1>

        <a asp-page="Crear" class="btn btn-sm btn-nuevo">
            <i class="fas fa-file me-1"></i> Nueva Solicitud
        </a>
    </div>
</div>

<!-- Card de Información -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="h5 fw-bold" style="color: #4e73df;">
            Información
        </h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 solicitudes-table">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="ps-4">Consecutivo</th>
                        <th scope="col">Título</th>
                        <th scope="col">Representante</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Módulo Externo</th>
                        <th scope="col">F. Ingreso</th>
                        <th scope="col">F. Respuesta</th>
                        <th scope="col">F. Inicio</th>
                        <th scope="col" class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Solicitudes == null || !Model.Solicitudes.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No se encontraron solicitudes registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Solicitudes)
                        {
                            var badgeClass = item.NombreEstado switch
                            {
                                "Nueva" => "text-bg-primary",
                                "Respondida" => "text-bg-success",
                                "Iniciada" => "text-bg-primary",
                                "Finalizada" => "text-bg-secondary",
                                "Vencida" => "text-bg-danger",
                                _ => "text-bg-secondary"
                            };
                            var iconClass = item.NombreEstado switch
                            {
                                "Nueva" => "fa-file",
                                "Respondida" => "fa-reply",
                                "Iniciada" => "fa-play-circle",
                                "Finalizada" => "fa-check-circle",
                                "Vencida" => "fa-exclamation-circle",
                                _ => "fa-circle"
                            };

                            <tr>
                                <td class="ps-4 fw-semibold">@item.ConsecutivoOficio</td>
                                <td>@item.Titulo</td>
                                <td>@item.NombreRepresentante</td>
                                <td>
                                    <span class="badge rounded-pill @badgeClass">
                                        <i class="fas @iconClass me-1" aria-hidden="true"></i>@item.NombreEstado
                                    </span>
                                </td>
                                <td>
                                    @if (!item.VisibleExterno)
                                    {
                                        <span class="badge rounded-pill text-bg-light border text-muted">
                                            <i class="fas fa-eye-slash me-1" aria-hidden="true"></i>No visible
                                        </span>
                                    }
                                    else if (item.EstaVisibleExternoVigente)
                                    {
                                        <span class="badge rounded-pill text-bg-info text-dark" title="Visible hasta @(item.FechaVencimientoPublicacion?.ToString("dd/MM/yyyy"))">
                                            <i class="fas fa-globe me-1" aria-hidden="true"></i>Visible (@item.FechaVencimientoPublicacion?.ToString("dd/MM/yyyy"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-secondary" title="Venció el @(item.FechaVencimientoPublicacion?.ToString("dd/MM/yyyy"))">
                                            <i class="fas fa-history me-1" aria-hidden="true"></i>Vencida (@item.FechaVencimientoPublicacion?.ToString("dd/MM/yyyy"))
                                        </span>
                                    }
                                </td>
                                <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td>@(item.FechaRespuesta.HasValue ? item.FechaRespuesta.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td>@(item.FechaInicio.HasValue ? item.FechaInicio.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Publicar a Proveedores (EXT1) -->
                                        <button type="button"
                                                class="btn btn-sm rounded-circle btn-accion"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalPublicar"
                                                data-id="@item.IdSolicitud"
                                                data-consecutivo="@item.ConsecutivoOficio"
                                                data-titulo="@item.Titulo"
                                                data-visible="@(item.VisibleExterno ? "true" : "false")"
                                                data-vencimiento="@(item.FechaVencimientoPublicacion.HasValue ? item.FechaVencimientoPublicacion.Value.ToString("yyyy-MM-dd") : "")"
                                                aria-label="Publicar @item.ConsecutivoOficio a proveedores"
                                                title="Publicar a proveedores">
                                            <i class="fas fa-globe fa-sm" aria-hidden="true"></i>
                                        </button>
                                        <!-- Participaciones (EXT7) -->
                                        <a asp-page="/Solicitudes/Participaciones/Index"
                                           asp-route-idSolicitud="@item.IdSolicitud"
                                           class="btn btn-sm rounded-circle btn-accion"
                                           aria-label="Participaciones de @item.ConsecutivoOficio"
                                           title="Participaciones">
                                            <i class="fas fa-handshake fa-sm" aria-hidden="true"></i>
                                        </a>
                                        <!-- Desglose -->
                                        <a asp-page="/Solicitudes/Desgloses/Index" asp-route-idSolicitud="@item.IdSolicitud"
                                           class="btn btn-sm rounded-circle btn-accion"
                                           aria-label="Administrar desgloses" title="Desglose">
                                            <i class="fas fa-list-alt fa-sm" aria-hidden="true"></i>
                                        </a>
                                        <!-- Editar -->
                                        <a asp-page="Editar" asp-route-id="@item.IdSolicitud"
                                           class="btn btn-sm rounded-circle btn-accion"
                                           aria-label="Editar @item.ConsecutivoOficio" title="Editar">
                                            <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                        </a>
                                        <!-- Tareas -->
                                        <a asp-page="/Solicitudes/Tareas/Index"
                                           asp-route-idSolicitud="@item.IdSolicitud"
                                           class="btn btn-sm rounded-circle btn-accion"
                                           aria-label="Tareas de @item.ConsecutivoOficio"
                                           title="Tareas">
                                            <i class="fas fa-tasks fa-sm" aria-hidden="true"></i>
                                        </a>
                                        <!-- Eliminar -->
                                        <button type="button"
                                                class="btn btn-sm rounded-circle btn-accion"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalEliminar"
                                                data-id="@item.IdSolicitud"
                                                data-consecutivo="@item.ConsecutivoOficio"
                                                aria-label="Eliminar @item.ConsecutivoOficio"
                                                title="Eliminar">
                                            <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación compacta (Máximo 5 elementos por página) -->
@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación de solicitudes" class="mt-3">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pagina="@(Model.PaginaActual - 1)"
                   aria-label="Anterior">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-pagina="@i">@i</a>
                </li>
            }

            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pagina="@(Model.PaginaActual + 1)"
                   aria-label="Siguiente">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<!-- Modal Publicar a Proveedores (EXT1) -->
<div class="modal fade" id="modalPublicar" tabindex="-1" aria-labelledby="modalPublicarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #4e73df;">
                <h5 class="modal-title" id="modalPublicarLabel">
                    <i class="fas fa-globe me-2"></i>Publicación a Proveedores
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" asp-page-handler="Publicar">
                <div class="modal-body">
                    <input type="hidden" name="idSolicitud" id="inputPublicarId" />
                    <input type="hidden" name="pagina" value="@Model.PaginaActual" />

                    <!-- Resumen de la solicitud -->
                    <div class="mb-3 p-3 bg-light rounded border">
                        <div class="small text-muted text-uppercase fw-bold" style="letter-spacing: 0.5px;">Solicitud</div>
                        <div class="fw-bold fs-6 text-dark" id="lblPublicarConsecutivo"></div>
                        <div class="small text-secondary" id="lblPublicarTitulo"></div>
                    </div>

                    <!-- Interruptor de visualización -->
                    <div class="form-check form-switch mb-3 ps-5">
                        <input class="form-check-input" type="checkbox" role="switch" id="chkVisibleExterno" name="visibleExterno" value="true">
                        <label class="form-check-label fw-bold text-dark" for="chkVisibleExterno">
                            Visualizar en módulo externo de proveedores
                        </label>
                        <div class="form-text small text-muted">
                            Si se activa, los proveedores podrán consultar esta solicitud desde el módulo externo.
                        </div>
                    </div>

                    <!-- Fecha de vencimiento -->
                    <div class="mb-3" id="grupoFechaVencimiento">
                        <label for="inputFechaVencimiento" class="form-label fw-bold text-dark mb-1" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                            Fecha de Vencimiento de Visualización <span class="text-danger" id="reqAsterisco">*</span>
                        </label>
                        <input type="date" class="form-control" id="inputFechaVencimiento" name="fechaVencimiento" />
                        <div class="form-text small text-muted">
                            Pasado este período no se mostrará más la solicitud en el módulo externo.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" style="background-color: #4e73df; border-color: #4e73df;">
                        <i class="fas fa-save me-1"></i>Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminarLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Realmente desea eliminar el elemento seleccionado?</p>
                <p class="fw-bold mb-0" id="lblConsecutivoEliminar"></p>
                <small class="text-muted">Esta acción no se puede deshacer.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>No
                </button>
                <form method="post" asp-page-handler="Eliminar" class="d-inline">
                    <input type="hidden" name="id" id="inputEliminarId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i>Sí
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Solicitudes.css" asp-append-version="true" />
    <script src="~/js/Solicitudes.js" asp-append-version="true"></script>

    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarMensaje('Ok', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MensajeExito)), 'success');
            });
        </script>
    }
    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarMensaje('Advertencia', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MensajeError)), 'warning');
            });
        </script>
    }
}
