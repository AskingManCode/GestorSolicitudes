@page
@model PublicaSA.Website.Pages.Solicitudes.Participaciones.IndexModel
@{
    ViewData["Title"] = "Participaciones de Solicitud";
}

<!-- Bloque superior con borde azul -->
<div class="card border-0 shadow-sm mb-4 desgloses-header-card">
    <div class="card-body py-3">
        <h1 class="h5 fw-bold mb-3">
            Participaciones de Proveedores (@Model.Solicitud?.ConsecutivoOficio - @Model.Solicitud?.Titulo)
        </h1>

        <div class="d-flex gap-2">
            <a asp-page="/Solicitudes/Index" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Regresar
            </a>
        </div>
    </div>
</div>

<!-- Alertas -->
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Card de Información -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="h5 fw-bold mb-0" style="color: #4e73df;">
            Información de Participaciones
        </h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 desgloses-table">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="ps-4">Identificación del Proveedor</th>
                        <th scope="col">Nombre del Proveedor</th>
                        <th scope="col">Fecha de Participación</th>
                        <th scope="col" class="text-center pe-4">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Participaciones == null || !Model.Participaciones.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No se han registrado participaciones de proveedores para esta solicitud.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Participaciones)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    <a asp-page="./Detalle"
                                       asp-route-idPropuesta="@item.IdPropuesta"
                                       asp-route-idSolicitud="@Model.IdSolicitud"
                                       class="fw-bold text-decoration-none"
                                       style="color: #4e73df;"
                                       title="Ver detalle del desglose propuesto por @item.NombreProveedor">
                                        <i class="fas fa-external-link-alt me-1 small" aria-hidden="true"></i>@item.CedulaJuridica
                                    </a>
                                </td>
                                <td>@item.NombreProveedor</td>
                                <td>@item.FechaPropuesta.ToString("dd/MM/yyyy")</td>
                                <td class="text-center pe-4">
                                    @if (item.Aprobada)
                                    {
                                        <span class="badge rounded-pill text-bg-success">
                                            <i class="fas fa-check-circle me-1" aria-hidden="true"></i>Aprobada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-secondary">
                                            <i class="fas fa-clock me-1" aria-hidden="true"></i>Recibida
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Desgloses.css" asp-append-version="true" />
}
