@page
@model PublicaSA.Website.Pages.Solicitudes.Desgloses.CrearModel
@{
    ViewData["Title"] = "Nuevo Desglose";
}

<!-- Encabezado -->
<div class="card border-0 shadow-sm mb-4 desgloses-header-card">
    <div class="card-body py-3">
        <!-- Botones circulares: Regresar / Guardar -->
        <div class="d-flex gap-2 mb-3">
            <a asp-page="/Solicitudes/Desgloses/Index" asp-route-idSolicitud="@Model.Input.IdSolicitud"
               class="btn btn-accion rounded-circle"
               aria-label="Regresar a desgloses"
               title="Regresar">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
            </a>
            <button type="submit"
                    form="formDesglose"
                    class="btn btn-accion rounded-circle"
                    aria-label="Guardar desglose"
                    title="Guardar">
                <i class="fas fa-save" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Card del formulario -->
<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <!-- Título -->
        <div class="mb-4 pb-3 border-bottom">
            <h5 class="fw-bold mb-0" style="color: #4e73df;">
                Formulario Desglose (@Model.Solicitud?.ConsecutivoOficio)
            </h5>
        </div>

        <form id="formDesglose" method="post">
            <input type="hidden" asp-for="Input.IdSolicitud" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Mes" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Mes <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Input.Mes" class="form-select">
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                    <span asp-validation-for="Input.Mes" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Anio" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Año <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Anio" type="number" class="form-control" />
                    <span asp-validation-for="Input.Anio" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Horas" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Horas <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Horas" type="number" step="0.25" min="0" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Input.Horas" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Monto" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Monto <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Monto" id="inputMonto" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Input.Monto" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        IVA (13%)
                    </label>
                    <input id="inputIva" type="text" class="form-control bg-light" readonly value="0.00" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Total (Monto + IVA)
                    </label>
                    <input id="inputTotal" type="text" class="form-control bg-light fw-bold text-primary" readonly value="0.00" />
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.PorcentajeCobro" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Porcentaje de Cobro (%) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <input asp-for="Input.PorcentajeCobro" type="number" step="0.1" min="0" max="100" class="form-control" placeholder="100" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="Input.PorcentajeCobro" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Observaciones" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Observaciones
                    </label>
                    <textarea asp-for="Input.Observaciones" class="form-control" rows="3" placeholder="Detalle u observaciones del trabajo realizado en el mes"></textarea>
                    <span asp-validation-for="Input.Observaciones" class="text-danger small"></span>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Desgloses.css" asp-append-version="true" />
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const montoInput = document.getElementById("inputMonto");
            const ivaInput = document.getElementById("inputIva");
            const totalInput = document.getElementById("inputTotal");

            function calcularMontos() {
                const monto = parseFloat(montoInput.value) || 0;
                const iva = monto * 0.13;
                const total = monto + iva;

                ivaInput.value = "₡" + iva.toFixed(2);
                totalInput.value = "₡" + total.toFixed(2);
            }

            montoInput.addEventListener("input", calcularMontos);
            calcularMontos();
        });
    </script>
}
