@page
@model PublicaSA.Website.Pages.Reportes.Tareas.PorSolicitudModel
@{
    ViewData["Title"] = "Reporte de Tareas por Solicitud";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Reporte de Tareas por Solicitud</h1>
            <p class="text-muted small mb-0">Tareas asociadas a una solicitud en un mes y año determinado</p>
        </div>
    </div>

    <!-- Parámetros del reporte -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-bold text-primary">Parámetros del Reporte</h6>
        </div>
        <div class="card-body p-4">
            <form method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label asp-for="IdSolicitud" class="form-label fw-semibold">
                            Solicitud <span class="text-danger">*</span>
                        </label>
                        <select asp-for="IdSolicitud" asp-items="Model.SolicitudesSelectList" class="form-select">
                            <option value="">-- Seleccione una solicitud --</option>
                        </select>
                        <span asp-validation-for="IdSolicitud" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Mes" class="form-label fw-semibold">
                            Mes <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Mes" asp-items="Model.MesesSelectList" class="form-select">
                            <option value="">-- Seleccione un mes --</option>
                        </select>
                        <span asp-validation-for="Mes" class="text-danger small"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Anio" class="form-label fw-semibold">
                            Año <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Anio" type="number" class="form-control" />
                        <span asp-validation-for="Anio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-1"></i> Generar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultado del reporte -->
    @if (Model.ReporteGenerado)
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary">Tareas de la Solicitud</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Usuario</th>
                                <th scope="col">Fecha</th>
                                <th scope="col">Descripción de la Tarea</th>
                                <th scope="col" class="text-end">Horas Invertidas</th>
                                <th scope="col">Consecutivo</th>
                                <th scope="col">Título de la Solicitud</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Tareas.Any())
                            {
                                @foreach (var item in Model.Tareas)
                                {
                                    <tr>
                                        <td>@item.NombreUsuario</td>
                                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>@item.Descripcion</td>
                                        <td class="text-end">@item.HorasInvertidas.ToString("N2")</td>
                                        <td class="fw-semibold">@item.ConsecutivoOficio</td>
                                        <td>@item.Titulo</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                        No se encontraron tareas para los parámetros seleccionados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="3" class="text-end">Total de horas invertidas en la solicitud:</th>
                                <th class="text-end">@Model.TotalHoras.ToString("N2")</th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
