@page
@model PublicaSA.Website.Pages.Reportes.Solicitudes.IndexModel

@{
    ViewData["Title"] = "Reporte mensual de montos";
}

<div class="reporte-solicitudes-page">
<div class="card border-0 shadow-sm mb-4 hu-header-card">
    <div class="card-body py-3">
        <h1 class="h5 fw-bold mb-3">Reporte Mensual de Montos</h1>
        <a asp-page="/Solicitudes/Index" class="btn btn-sm btn-secondary">
            <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>Regresar a Solicitudes
        </a>
    </div>
</div>
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h2 class="h5 fw-bold hu-card-title">Filtros del Reporte</h2>
    </div>
    <div class="card-body p-4">

@* Solicita el mes y año para generar el reporte. *@
<form method="post" class="hu-form">
    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Mes" class="form-label">
                Mes
            </label>

            <select asp-for="Mes" class="form-select">
                <option value="">Seleccione el mes</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>

            <span asp-validation-for="Mes"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Anio" class="form-label">
                Año
            </label>

            <input asp-for="Anio"
                   type="number"
                   min="2000"
                   max="2150"
                   step="1"
                   class="form-control" />

            <span asp-validation-for="Anio"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-hu-primary">
                <i class="fas fa-search me-1" aria-hidden="true"></i>Generar Reporte
            </button>
        </div>
    </div>
</form>
    </div>
</div>

@if (Model.Reporte is not null)
{
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h5 fw-bold mb-0 hu-card-title">Información</h2>
            <span class="text-muted small">Período: @Model.Mes / @Model.Anio</span>
        </div>
        <div class="card-body p-0">

    @* Muestra los importes por solicitud y sus sumas finales. *@
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0 hu-table">
            <thead class="table-dark">
                <tr>
                    <th scope="col" class="ps-4">Consecutivo del oficio</th>
                    <th scope="col">Título de la solicitud</th>
                    <th scope="col">Mes</th>
                    <th scope="col">Año</th>
                    <th scope="col" class="text-end hu-number">Monto</th>
                    <th scope="col" class="text-end hu-number">IVA</th>
                    <th scope="col" class="text-end hu-number">Total por solicitud</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var solicitud in Model.Reporte.Solicitudes)
                {
                    <tr>
                        <td class="ps-4">@solicitud.ConsecutivoOficio</td>
                        <td>@solicitud.Titulo</td>
                        <td>@solicitud.Mes</td>
                        <td>@solicitud.Anio</td>
                        <td class="text-end hu-number">
                            @solicitud.Monto.ToString("N2")
                        </td>
                        <td class="text-end hu-number">
                            @solicitud.Iva.ToString("N2")
                        </td>
                        <td class="text-end hu-number">
                            @solicitud.Total.ToString("N2")
                        </td>
                    </tr>
                }

                @if (!Model.Reporte.Solicitudes.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No hay datos para el período seleccionado.
                        </td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr class="fw-bold">
                    <th colspan="4" scope="row" class="ps-4">
                        Sumas
                    </th>
                    <td class="text-end hu-number">
                        @Model.Reporte.SumaMonto.ToString("N2")
                    </td>
                    <td class="text-end hu-number">
                        @Model.Reporte.SumaIva.ToString("N2")
                    </td>
                    <td class="text-end hu-number">
                        @Model.Reporte.SumaTotal.ToString("N2")
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
        </div>
    </div>
}
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/ReporteSolicitudes.css" asp-append-version="true" />
    <partial name="_ValidationScriptsPartial" />
}
