@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    bool IsActive(string prefix) =>
        currentPage.Equals(prefix, StringComparison.OrdinalIgnoreCase) ||
        currentPage.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);

    bool inReportes = IsActive("/Reportes");
    var pageTitle = ViewData["Title"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "" : pageTitle + " - ")Pública S.A.</title>

    <!-- Aplica el estado del sidebar ANTES de pintar: evita el parpadeo al navegar -->
    <script>
            try {
                if (localStorage.getItem("sidebar-collapsed") === "1")
                    document.documentElement.classList.add("sidebar-collapsed");
            } catch (e) { }
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
</head>
<body>

    <!-- Modal global de mensajes -->
    <div class="modal fade" id="modalMensaje" tabindex="-1" aria-labelledby="modalMensajeLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" id="modalMensajeHeader">
                    <h5 class="modal-title" id="modalMensajeLabel">Mensaje</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalMensajeBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex" id="wrapper">

        <!-- SIDEBAR -->
        <aside id="sidebar-wrapper" class="bg-sidebar">

            <!-- Brand -->
            <div class="sidebar-heading text-white d-flex align-items-center px-3 py-3">
                <div class="sidebar-brand-icon me-3">
                    <img src="~/images/logo.png" alt="Logo de Pública S.A." class="logo-img" />
                </div>
                <div class="sidebar-brand-text fw-bold">Pública S.A.</div>
            </div>

            <!-- Menú -->
            <nav class="list-group list-group-flush pt-2" aria-label="Menú principal">

                <!-- Grupo Reportes -->
                <a class="list-group-item list-group-item-action bg-sidebar text-white d-flex justify-content-between align-items-center @(inReportes ? "is-active-group" : "collapsed")"
                   id="reportesToggle"
                   data-bs-toggle="collapse"
                   data-label="Reportes"
                   href="#collapseReportes"
                   role="button"
                   aria-expanded="@(inReportes ? "true" : "false")"
                   aria-controls="collapseReportes">

                    <span class="sidebar-group-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             class="icon icon-tabler icons-tabler-outline icon-tabler-report-search" aria-hidden="true">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M8 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h5.697" />
                            <path d="M18 12v-5a2 2 0 0 0 -2 -2h-2" />
                            <path d="M8 5a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2" />
                            <path d="M8 11h4" />
                            <path d="M8 15h3" />
                            <path d="M14 17.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0" />
                            <path d="M18.5 19.5l2.5 2.5" />
                        </svg>
                        <span class="sidebar-text">Reportes</span>
                    </span>

                    <i class="fas fa-chevron-down small sidebar-text sidebar-chevron" aria-hidden="true"></i>
                </a>

                <!-- Contenido del collapse (abre automáticamente si la página actual es un reporte) -->
                <div class="collapse @(inReportes ? "show" : "")" id="collapseReportes">
                    <a asp-page="/Reportes/Solicitudes/Index"
                       class="list-group-item list-group-item-action bg-sidebar text-white sidebar-subitem @(IsActive("/Reportes/Solicitudes") ? "is-active" : "")"
                       aria-current="@(IsActive("/Reportes/Solicitudes") ? "page" : null)">
                        <span class="sidebar-text">Solicitudes</span>
                    </a>

                    <a asp-page="/Reportes/Tareas/Index"
                       class="list-group-item list-group-item-action bg-sidebar text-white sidebar-subitem @(IsActive("/Reportes/Tareas/Index") ? "is-active" : "")"
                       aria-current="@(IsActive("/Reportes/Tareas/Index") ? "page" : null)">
                        <span class="sidebar-text">Tareas por usuario</span>
                    </a>

                    <a asp-page="/Reportes/Tareas/PorSolicitud"
                       class="list-group-item list-group-item-action bg-sidebar text-white sidebar-subitem @(IsActive("/Reportes/Tareas/PorSolicitud") ? "is-active" : "")"
                       aria-current="@(IsActive("/Reportes/Tareas/PorSolicitud") ? "page" : null)">
                        <span class="sidebar-text">Tareas por solicitud</span>
                    </a>
                </div>

                <a asp-page="/Solicitudes/Index"
                   data-label="Solicitudes"
                   class="list-group-item list-group-item-action bg-sidebar text-white @(IsActive("/Solicitudes") ? "is-active" : "")"
                   aria-current="@(IsActive("/Solicitudes") ? "page" : null)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-ticket" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M15 5l0 2" />
                        <path d="M15 11l0 2" />
                        <path d="M15 17l0 2" />
                        <path d="M5 5h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-3a2 2 0 0 0 0 -4v-3a2 2 0 0 1 2 -2" />
                    </svg>
                    <span class="sidebar-text">Solicitudes</span>
                </a>

                <a asp-page="/Representantes/Index"
                   data-label="Representantes"
                   class="list-group-item list-group-item-action bg-sidebar text-white @(IsActive("/Representantes") ? "is-active" : "")"
                   aria-current="@(IsActive("/Representantes") ? "page" : null)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-folder-user" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M12.75 19h-7.75a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2h4l3 3h7a2 2 0 0 1 2 2v2.5" />
                        <path d="M17 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                        <path d="M22 22a2 2 0 0 0 -2 -2h-2a2 2 0 0 0 -2 2" />
                    </svg>
                    <span class="sidebar-text">Representantes</span>
                </a>

                <a asp-page="/Estados/Index"
                   data-label="Estados"
                   class="list-group-item list-group-item-action bg-sidebar text-white @(IsActive("/Estados") ? "is-active" : "")"
                   aria-current="@(IsActive("/Estados") ? "page" : null)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-progress-alert" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M10 20.777a8.942 8.942 0 0 1 -2.48 -.969" />
                        <path d="M14 3.223a9.003 9.003 0 0 1 0 17.554" />
                        <path d="M4.579 17.093a8.961 8.961 0 0 1 -1.227 -2.592" />
                        <path d="M3.124 10.5c.16 -.95 .468 -1.85 .9 -2.675l.169 -.305" />
                        <path d="M6.907 4.579a8.954 8.954 0 0 1 3.093 -1.356" />
                        <path d="M12 8v4" />
                        <path d="M12 16v.01" />
                    </svg>
                    <span class="sidebar-text">Estados</span>
                </a>

                <a asp-page="/Usuarios/Index"
                   data-label="Usuarios"
                   class="list-group-item list-group-item-action bg-sidebar text-white @(IsActive("/Usuarios") ? "is-active" : "")"
                   aria-current="@(IsActive("/Usuarios") ? "page" : null)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                        <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                    </svg>
                    <span class="sidebar-text">Usuarios</span>
                </a>

            </nav>

            <!-- Botón inferior para colapsar (escritorio) -->
            <div class="sidebar-footer text-center py-3">
                <button type="button" class="btn btn-sm btn-light rounded-circle" id="sidebarToggle"
                        aria-label="Ocultar o mostrar menú" aria-controls="sidebar-wrapper" aria-expanded="true">
                    <i class="fas fa-angle-left" id="sidebarToggleIcon" aria-hidden="true"></i>
                </button>
            </div>
        </aside>
        <!-- FIN SIDEBAR -->
        <!-- Fondo para cerrar el menú en móvil -->
        <div id="sidebarBackdrop" class="sidebar-backdrop" hidden></div>

        <!-- Contenido -->
        <div id="page-content-wrapper">

            <!-- Topbar (fija al hacer scroll) -->
            <nav class="navbar navbar-expand navbar-light bg-white border-bottom shadow-sm sticky-top">
                <div class="container-fluid">

                    <!-- Hamburguesa: solo visible en móvil -->
                    <!-- <button type="button" class="btn btn-link text-secondary p-0 d-md-none" id="sidebarOpen"
                            aria-label="Abrir menú" aria-controls="sidebar-wrapper" aria-expanded="false">
                        <i class="fas fa-bars fa-lg" aria-hidden="true"></i>
                    </button> -->

                    <!-- Avatar + Nombre -->
                    <div class="d-flex align-items-center ms-auto topbar-user">
                        <span class="fw-semibold text-secondary me-2 text-truncate d-none d-sm-inline">
                            <!-- @User.Identity?.Name -->
                            Nombre del Usuario
                        </span>
                        <img src="~/images/avatar-default.png"
                             alt="Avatar del usuario"
                             class="topbar-avatar" />
                    </div>

                </div>
            </nav>

            <!-- Body -->
            <main class="container-fluid px-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/_Layout.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
