@page
@model PublicaSA.Website.Pages.Representantes.IndexModel
@{
    ViewData["Title"] = "Mantenimiento de Representantes";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Administración de Representantes</h1>
            <p class="text-muted small mb-0">Personas a las que se puede contactar en caso de dudas sobre la solicitud</p>
        </div>
        <a asp-page="/Representantes/Crear" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="fas fa-plus"></i>
            <span>Nuevo</span>
        </a>
    </div>

    <!-- Alertas de mensajes -->
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Representantes -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">Listado de Representantes</h6>
            <span class="badge bg-secondary">Total: @Model.TotalRegistros</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">Email</th>
                            <th scope="col" class="text-center" style="min-width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Representantes != null && Model.Representantes.Any())
                        {
                            @foreach (var item in Model.Representantes)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Nombre</td>
                                    <td>@item.Email</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="/Representantes/Editar" asp-route-id="@item.IdRepresentante" class="btn btn-outline-primary" title="Editar">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                            <button type="button" class="btn btn-outline-danger"
                                                    data-id="@item.IdRepresentante"
                                                    data-nombre="@item.Nombre"
                                                    onclick="confirmarEliminar(this)"
                                                    title="Eliminar">
                                                <i class="fas fa-trash-alt"></i> Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                    No se encontraron representantes registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginación (Máximo 10 elementos por página) -->
        @if (Model.TotalPaginas > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <div class="small text-muted">
                    Página @Model.PaginaActual de @Model.TotalPaginas (Mostrando máximo 10 representantes por página)
                </div>
                <nav aria-label="Navegación de páginas">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Representantes/Index" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-page="/Representantes/Index" asp-route-pagina="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-page="/Representantes/Index" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalConfirmarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalConfirmarEliminarLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2 fs-6">¿Realmente desea eliminar el elemento seleccionado?</p>
                <p class="text-muted small mb-0">Representante: <strong id="lblNombreEliminar"></strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form method="post" asp-page-handler="Eliminar" id="formEliminar" class="d-inline">
                    <input type="hidden" name="id" id="inputEliminarId" value="" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Notificación de Error al Eliminar (Datos Relacionados) -->
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="modal fade" id="modalMensajeError" tabindex="-1" aria-labelledby="modalMensajeErrorLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="modalMensajeErrorLabel">
                        <i class="fas fa-exclamation-triangle me-2"></i>Atención
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="mb-3 text-danger">
                        <i class="fas fa-times-circle fa-3x"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">No se puede eliminar el representante</h5>
                    <p class="fs-6 text-muted mb-0">@Model.MensajeError</p>
                </div>
                <div class="modal-footer justify-content-center bg-light">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmarEliminar(boton) {
            document.getElementById('inputEliminarId').value = boton.dataset.id;
            document.getElementById('lblNombreEliminar').textContent = boton.dataset.nombre;
            const modal = new bootstrap.Modal(document.getElementById('modalConfirmarEliminar'));
            modal.show();
        }

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                const modalErrorEl = document.getElementById('modalMensajeError');
                if (modalErrorEl) {
                    const modalError = new bootstrap.Modal(modalErrorEl);
                    modalError.show();
                }
            });
            </text>
        }
    </script>
}
