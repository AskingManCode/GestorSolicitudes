@page
@model PublicaSA.Website.Pages.Solicitudes.Desgloses.IndexModel
@{
    ViewData["Title"] = "Desgloses";
}

<!-- Bloque superior con borde azul -->
<div class="card border-0 shadow-sm mb-4 desgloses-header-card">
    <div class="card-body py-3">
        <h1 class="h5 fw-bold mb-3">
            Mantenimiento de Desgloses (@Model.Solicitud?.ConsecutivoOficio)
        </h1>

        <div class="d-flex gap-2">
            <a asp-page="/Solicitudes/Index" class="btn btn-sm btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Regresar a Solicitudes
            </a>
            <a asp-page="Crear" asp-route-idSolicitud="@Model.IdSolicitud" class="btn btn-sm btn-nuevo">
                <i class="fas fa-file me-1"></i> Nuevo Desglose
            </a>
        </div>
    </div>
</div>

<!-- Alertas -->
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Card de Información -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="h5 fw-bold" style="color: #4e73df;">
            Información
        </h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 desgloses-table">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="ps-4">Mes</th>
                        <th scope="col">Año</th>
                        <th scope="col" class="text-end">Horas</th>
                        <th scope="col" class="text-end">Monto Base</th>
                        <th scope="col" class="text-end">IVA (13%)</th>
                        <th scope="col" class="text-end">Total</th>
                        <th scope="col" class="text-center">% Cobro</th>
                        <th scope="col">Observaciones</th>
                        <th scope="col" class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Desgloses == null || !Model.Desgloses.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No hay desgloses registrados para esta solicitud.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Desgloses)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.NombreMes</td>
                                <td>@item.Anio</td>
                                <td class="text-end">@item.Horas.ToString("N2")</td>
                                <td class="text-end">₡@item.Monto.ToString("N2")</td>
                                <td class="text-end text-muted">₡@item.Iva.ToString("N2")</td>
                                <td class="text-end fw-bold text-primary">₡@item.Total.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge rounded-pill text-bg-info">@item.PorcentajeCobro%</span>
                                </td>
                                <td class="small text-muted text-truncate" style="max-width: 200px;" title="@item.Observaciones">
                                    @(string.IsNullOrWhiteSpace(item.Observaciones) ? "-" : item.Observaciones)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Editar -->
                                        <a asp-page="Editar" asp-route-id="@item.IdDesglose" 
                                           class="btn btn-sm rounded-circle btn-accion" 
                                           aria-label="Editar desglose" title="Editar">
                                            <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                        </a>
                                        <!-- Eliminar -->
                                        <button type="button" 
                                                class="btn btn-sm rounded-circle btn-accion" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#modalEliminar"
                                                data-id="@item.IdDesglose" 
                                                data-detalle="@item.NombreMes @item.Anio"
                                                aria-label="Eliminar desglose" 
                                                title="Eliminar">
                                            <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación compacta (Máximo 10 elementos por página) -->
@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación de desgloses" class="mt-3">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-idSolicitud="@Model.IdSolicitud" asp-route-pagina="@(Model.PaginaActual - 1)" 
                   aria-label="Anterior">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-idSolicitud="@Model.IdSolicitud" asp-route-pagina="@i">@i</a>
                </li>
            }
            
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-idSolicitud="@Model.IdSolicitud" asp-route-pagina="@(Model.PaginaActual + 1)" 
                   aria-label="Siguiente">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminarLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Realmente desea eliminar el elemento seleccionado?</p>
                <p class="fw-bold mb-0">Desglose correspondiente a: <span id="lblDesgloseDetalle"></span></p>
                <small class="text-muted">Esta acción no se puede deshacer.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>No
                </button>
                <form method="post" asp-page-handler="Eliminar" class="d-inline">
                    <input type="hidden" name="id" id="inputEliminarDesgloseId" />
                    <input type="hidden" name="idSolicitud" value="@Model.IdSolicitud" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i>Sí
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Desgloses.css" asp-append-version="true" />
    <script src="~/js/Desgloses.js" asp-append-version="true"></script>
}
