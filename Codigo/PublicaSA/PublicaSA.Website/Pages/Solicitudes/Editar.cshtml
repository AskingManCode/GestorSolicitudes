@page "{id:int}"
@model PublicaSA.Website.Pages.Solicitudes.EditarModel
@{
    ViewData["Title"] = "Editar Solicitud";
}

<!-- Encabezado -->
<div class="card border-0 shadow-sm mb-4 solicitudes-header-card">
    <div class="card-body py-3">
        <!-- Botones circulares: Regresar / Guardar -->
        <div class="d-flex gap-2 mb-3">
            <a asp-page="Index"
               class="btn btn-accion rounded-circle"
               aria-label="Regresar al listado"
               title="Regresar">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
            </a>
            <button type="submit"
                    form="formEditSolicitud"
                    class="btn btn-accion rounded-circle"
                    aria-label="Guardar cambios"
                    title="Guardar">
                <i class="fas fa-save" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Card del formulario -->
<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <!-- Título -->
        <div class="mb-4 pb-3 border-bottom">
            <h5 class="fw-bold mb-0" style="color: #4e73df;">
                Editar Solicitud
            </h5>
        </div>

        <form id="formEditSolicitud" method="post">
            <input type="hidden" asp-for="Input.IdSolicitud" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.ConsecutivoOficio" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Consecutivo de Oficio <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.ConsecutivoOficio" class="form-control" />
                    <span asp-validation-for="Input.ConsecutivoOficio" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Titulo" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Título de la Solicitud <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Titulo" class="form-control" />
                    <span asp-validation-for="Input.Titulo" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.IdRepresentante" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Representante <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Input.IdRepresentante" asp-items="Model.RepresentantesSelectList" class="form-select">
                        <option value="">-- Seleccione un representante --</option>
                    </select>
                    <span asp-validation-for="Input.IdRepresentante" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.CodigoEstado" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Estado de la Solicitud <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Input.CodigoEstado" asp-items="Model.EstadosSelectList" class="form-select">
                    </select>
                    <span asp-validation-for="Input.CodigoEstado" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.FechaIngreso" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Fecha de Ingreso <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.FechaIngreso" type="date" class="form-control" />
                    <span asp-validation-for="Input.FechaIngreso" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.FechaInicio" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Fecha de Inicio
                    </label>
                    <input asp-for="Input.FechaInicio" type="date" class="form-control" />
                    <span asp-validation-for="Input.FechaInicio" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.FechaRespuesta" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Fecha de Respuesta
                    </label>
                    <input asp-for="Input.FechaRespuesta" type="date" class="form-control" />
                    <span asp-validation-for="Input.FechaRespuesta" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.DocumentoInicio" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Documento de Inicio
                    </label>
                    <input asp-for="Input.DocumentoInicio" class="form-control" />
                    <span asp-validation-for="Input.DocumentoInicio" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.DocumentoRespuesta" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Documento de Respuesta
                    </label>
                    <input asp-for="Input.DocumentoRespuesta" class="form-control" />
                    <span asp-validation-for="Input.DocumentoRespuesta" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Descripcion" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Descripción
                    </label>
                    <textarea asp-for="Input.Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Input.Descripcion" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Observaciones" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Observaciones
                    </label>
                    <textarea asp-for="Input.Observaciones" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Input.Observaciones" class="text-danger small"></span>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Solicitudes.css" asp-append-version="true" />
    <partial name="_ValidationScriptsPartial" />
}
