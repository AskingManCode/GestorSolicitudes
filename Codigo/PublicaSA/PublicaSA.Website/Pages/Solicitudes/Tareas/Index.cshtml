@page
@model PublicaSA.Website.Pages.Solicitudes.Tareas.IndexModel
@{
    ViewData["Title"] = "Tareas de la solicitud";
}

<div class="tareas-page">
    <div class="card border-0 shadow-sm mb-4 hu-header-card">
        <div class="card-body py-3">
            <h1 class="h5 fw-bold mb-3">Mantenimiento de Tareas</h1>
            <div class="d-flex flex-wrap align-items-center gap-2 hu-header-actions">
                @if (Model.Error is null)
                {
                    <a asp-page="./Nuevo" asp-route-idSolicitud="@Model.IdSolicitud"
                       class="btn btn-sm btn-hu-primary">
                        <i class="fas fa-file me-1" aria-hidden="true"></i>Nueva Tarea
                    </a>
                }
                <a asp-page="/Solicitudes/Index" class="btn btn-sm btn-secondary">
                    <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>Regresar a Solicitudes
                </a>
                <span class="text-muted small ms-sm-2">Solicitud: @Model.IdSolicitud</span>
            </div>
        </div>
    </div>

    @if (TempData["MensajeExitoTareas"] is string mensajeExito)
    {
        <div class="alert alert-success" role="alert">@mensajeExito</div>
    }
    @if (TempData["MensajeErrorTareas"] is string mensajeError)
    {
        <div class="alert alert-danger" role="alert">@mensajeError</div>
    }
    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h2 class="h5 fw-bold hu-card-title">Información</h2>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0 hu-table">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col" class="ps-4 col-id">ID</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Fecha</th>
                                <th scope="col">Usuario</th>
                                <th scope="col" class="text-end">Horas invertidas</th>
                                <th scope="col" class="text-end pe-4 col-acciones">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tarea in Model.Tareas)
                            {
                                <tr>
                                    <td class="ps-4">@tarea.IdTarea</td>
                                    <td class="hu-task-description">@tarea.Descripcion</td>
                                    <td class="hu-number">@tarea.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@tarea.NombreUsuario</td>
                                    <td class="text-end hu-number">@tarea.HorasInvertidas.ToString("0.00")</td>
                                    <td class="text-end pe-4 hu-actions">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-page="./Editar" asp-route-idTarea="@tarea.IdTarea"
                                               asp-route-idSolicitud="@Model.IdSolicitud"
                                               class="btn btn-sm btn-hu-action" title="Editar tarea"
                                               aria-label="Editar tarea @tarea.IdTarea">
                                                <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-hu-action"
                                                    data-bs-toggle="modal" data-bs-target="#modalEliminarTarea"
                                                    data-id-tarea="@tarea.IdTarea"
                                                    title="Eliminar tarea" aria-label="Eliminar tarea @tarea.IdTarea">
                                                <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Tareas.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No hay tareas en esta página.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de tareas" class="mt-3">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                        @if (Model.Pagina > 1)
                        {
                            <a class="page-link" asp-page="./Index" asp-route-idSolicitud="@Model.IdSolicitud"
                               asp-route-pagina="@(Model.Pagina - 1)" aria-label="Anterior">
                                <i class="fas fa-chevron-left" aria-hidden="true"></i>
                            </a>
                        }
                        else
                        {
                            <span class="page-link" aria-label="Anterior">
                                <i class="fas fa-chevron-left" aria-hidden="true"></i>
                            </span>
                        }
                    </li>
                    @for (int i = Math.Max(1, Model.Pagina - 2); i <= Math.Min(Model.TotalPaginas, Model.Pagina + 2); i++)
                    {
                        <li class="page-item @(i == Model.Pagina ? "active" : "")">
                            <a class="page-link" asp-page="./Index" asp-route-idSolicitud="@Model.IdSolicitud"
                               asp-route-pagina="@i" aria-current="@(i == Model.Pagina ? "page" : null)">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                        @if (Model.Pagina < Model.TotalPaginas)
                        {
                            <a class="page-link" asp-page="./Index" asp-route-idSolicitud="@Model.IdSolicitud"
                               asp-route-pagina="@(Model.Pagina + 1)" aria-label="Siguiente">
                                <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            </a>
                        }
                        else
                        {
                            <span class="page-link" aria-label="Siguiente">
                                <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            </span>
                        }
                    </li>
                </ul>
            </nav>
        }

        <div class="modal fade" id="modalEliminarTarea" tabindex="-1"
             aria-labelledby="tituloEliminarTarea" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h2 class="modal-title h5" id="tituloEliminarTarea">
                            <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>Confirmar eliminación
                        </h2>
                        <button type="button" class="btn-close btn-close-white"
                                data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        ¿Realmente desea eliminar el elemento seleccionado?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                        <form method="post" asp-page-handler="Eliminar">
                            <input type="hidden" name="IdSolicitud" value="@Model.IdSolicitud" />
                            <input type="hidden" name="idTarea" id="idTareaEliminar" />
                            <button type="submit" class="btn btn-danger">Sí</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Tareas.css" asp-append-version="true" />
    <script>
        document.getElementById("modalEliminarTarea")
            ?.addEventListener("show.bs.modal", function (event) {
                const boton = event.relatedTarget;
                const campo = document.getElementById("idTareaEliminar");
                if (boton && campo) {
                    campo.value = boton.getAttribute("data-id-tarea");
                }
            });
    </script>
}
