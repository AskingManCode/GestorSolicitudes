@page
@model PublicaSA.Website.Pages.Solicitudes.IndexModel
@{
    ViewData["Title"] = "Solicitudes";
}

<!-- Bloque superior con borde azul -->
<div class="card border-0 shadow-sm mb-4 solicitudes-header-card">
    <div class="card-body py-3">
        <h1 class="h5 fw-bold mb-3">
            Mantenimiento de Solicitudes
        </h1>

        <a asp-page="Crear" class="btn btn-sm btn-nuevo">
            <i class="fas fa-file me-1"></i> Nueva Solicitud
        </a>
    </div>
</div>

<!-- Alertas de mensajes -->
@if (!string.IsNullOrEmpty(Model.MensajeExito))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @Model.MensajeExito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Card de Información -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="h5 fw-bold" style="color: #4e73df;">
            Información
        </h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 solicitudes-table">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="ps-4">Consecutivo</th>
                        <th scope="col">Título</th>
                        <th scope="col">Representante</th>
                        <th scope="col">Estado</th>
                        <th scope="col">F. Ingreso</th>
                        <th scope="col">F. Respuesta</th>
                        <th scope="col">F. Inicio</th>
                        <th scope="col" class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Solicitudes == null || !Model.Solicitudes.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No se encontraron solicitudes registradas.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Solicitudes)
                        {
                            var semaforoClase = item.SemaforoColor;
                            var badgeClass = item.NombreEstado switch
                            {
                                "Nueva" => "text-bg-success",
                                "Respondida" => "text-bg-info",
                                "Iniciada" => "text-bg-primary",
                                "Finalizada" => "text-bg-secondary",
                                "Vencida" => "text-bg-danger",
                                _ => "text-bg-secondary"
                            };
                            var iconClass = item.NombreEstado switch
                            {
                                "Nueva" => "fa-file",
                                "Respondida" => "fa-reply",
                                "Iniciada" => "fa-play-circle",
                                "Finalizada" => "fa-check-circle",
                                "Vencida" => "fa-exclamation-circle",
                                _ => "fa-circle"
                            };

                            <tr class="@semaforoClase">
                                <td class="ps-4 fw-semibold">@item.ConsecutivoOficio</td>
                                <td>@item.Titulo</td>
                                <td>@item.NombreRepresentante</td>
                                <td>
                                    <span class="badge rounded-pill @badgeClass">
                                        <i class="fas @iconClass me-1" aria-hidden="true"></i>@item.NombreEstado
                                    </span>
                                </td>
                                <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td>@(item.FechaRespuesta.HasValue ? item.FechaRespuesta.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td>@(item.FechaInicio.HasValue ? item.FechaInicio.Value.ToString("dd/MM/yyyy") : "-")</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Desglose -->
                                        <a asp-page="/Solicitudes/Desgloses/Index" asp-route-idSolicitud="@item.IdSolicitud" 
                                           class="btn btn-sm rounded-circle btn-accion" 
                                           aria-label="Administrar desgloses" title="Desglose">
                                            <i class="fas fa-list-alt fa-sm" aria-hidden="true"></i>
                                        </a>
                                        <!-- Editar -->
                                        <a asp-page="Editar" asp-route-id="@item.IdSolicitud" 
                                           class="btn btn-sm rounded-circle btn-accion" 
                                           aria-label="Editar @item.ConsecutivoOficio" title="Editar">
                                            <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                        </a>
                                        <!-- Eliminar -->
                                        <button type="button" 
                                                class="btn btn-sm rounded-circle btn-accion" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#modalEliminar"
                                                data-id="@item.IdSolicitud"
                                                data-consecutivo="@item.ConsecutivoOficio"
                                                aria-label="Eliminar @item.ConsecutivoOficio" 
                                                title="Eliminar">
                                            <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación compacta (Máximo 5 elementos por página) -->
@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación de solicitudes" class="mt-3">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pagina="@(Model.PaginaActual - 1)" 
                   aria-label="Anterior">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-pagina="@i">@i</a>
                </li>
            }
            
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pagina="@(Model.PaginaActual + 1)" 
                   aria-label="Siguiente">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminarLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Realmente desea eliminar el elemento seleccionado?</p>
                <p class="fw-bold mb-0" id="lblConsecutivoEliminar"></p>
                <small class="text-muted">Esta acción no se puede deshacer.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>No
                </button>
                <form method="post" asp-page-handler="Eliminar" class="d-inline">
                    <input type="hidden" name="id" id="inputEliminarId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i>Sí
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Solicitudes.css" asp-append-version="true" />
    <script src="~/js/Solicitudes.js" asp-append-version="true"></script>
}
