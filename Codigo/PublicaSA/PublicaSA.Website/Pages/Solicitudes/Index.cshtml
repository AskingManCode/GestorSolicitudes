@page
@model PublicaSA.Website.Pages.Solicitudes.IndexModel
@{
    ViewData["Title"] = "Mantenimiento de Solicitudes";
}

<div class="container-fluid px-0 solicitudes-page">
    <div class="card border-0 shadow-sm mb-4 hu-header-card">
        <div class="card-body py-3">
            <h1 class="h5 fw-bold mb-3">Mantenimiento de Solicitudes</h1>
            <a asp-page="/Solicitudes/Crear" class="btn btn-sm btn-hu-primary">
                <i class="fas fa-file me-1" aria-hidden="true"></i>Nueva Solicitud
            </a>
        </div>
    </div>

    <!-- Alertas de mensajes -->
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Listado con tabla -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h2 class="h5 fw-bold hu-card-title">Información</h2>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0 hu-table">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="ps-4">Consecutivo</th>
                            <th scope="col">Título</th>
                            <th scope="col">Representante</th>
                            <th scope="col">Estado</th>
                            <th scope="col">F. Ingreso</th>
                            <th scope="col">F. Respuesta</th>
                            <th scope="col">F. Inicio</th>
                            <th scope="col" class="text-end pe-4 col-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Solicitudes != null && Model.Solicitudes.Any())
                        {
                            @foreach (var item in Model.Solicitudes)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@item.ConsecutivoOficio</td>
                                    <td>@item.Titulo</td>
                                    <td>@item.NombreRepresentante</td>
                                    <td>
                                        @{
    var colorEstado = item.CodigoEstado.ToUpperInvariant() switch
    {
        "NUEVA" => "text-bg-primary",
        "RESPONDIDA" => "text-bg-success",
        "VENCIDA" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
<span class="badge rounded-pill @colorEstado">
    @(item.NombreEstado ?? item.CodigoEstado)
</span>
                                    </td>
                                    <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td>@(item.FechaRespuesta.HasValue ? item.FechaRespuesta.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    <td>@(item.FechaInicio.HasValue ? item.FechaInicio.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    <td class="text-end pe-4 hu-actions">
                                        <div class="d-inline-flex gap-2" role="group" aria-label="Acciones de la solicitud">
                                            <a asp-page="/Solicitudes/Desgloses/Index" asp-route-idSolicitud="@item.IdSolicitud" class="btn btn-sm btn-hu-action" title="Administrar Desglose" aria-label="Administrar Desglose de la solicitud @item.ConsecutivoOficio">
                                                <i class="fas fa-list-alt fa-sm" aria-hidden="true"></i>
                                            </a>
                                            <a asp-page="/Solicitudes/Editar" asp-route-id="@item.IdSolicitud" class="btn btn-sm btn-hu-action" title="Editar" aria-label="Editar de la solicitud @item.ConsecutivoOficio">
                                                <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                            </a>

                                            @* Abre las tareas asociadas a la solicitud de esta fila. *@
                                            <a asp-page="/Solicitudes/Tareas/Index"
                                               asp-route-idSolicitud="@item.IdSolicitud"
                                               class="btn btn-sm btn-hu-action"
                                               title="Tareas" aria-label="Tareas de la solicitud @item.ConsecutivoOficio">
                                                <i class="fas fa-tasks fa-sm" aria-hidden="true"></i>
                                            </a>



                                            <button type="button" class="btn btn-sm btn-hu-action"
                                                    onclick="confirmarEliminar(this.dataset.id, this.dataset.consecutivo)"
                                                    data-id="@item.IdSolicitud" data-consecutivo="@item.ConsecutivoOficio"
                                                    title="Eliminar" aria-label="Eliminar de la solicitud @item.ConsecutivoOficio">
                                                <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                    No se encontraron solicitudes registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginación (Máximo 5 elementos por página) -->
        @if (Model.TotalPaginas > 1)
        {
            <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                <div class="small text-muted">
                    Página @Model.PaginaActual de @Model.TotalPaginas (Mostrando máximo 5 solicitudes por página)
                </div>
                <nav aria-label="Navegación de páginas">
                    <ul class="pagination pagination-sm justify-content-end mb-0">
                        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Solicitudes/Index" asp-route-pagina="@(Model.PaginaActual - 1)" aria-label="Anterior"><i class="fas fa-chevron-left" aria-hidden="true"></i></a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-page="/Solicitudes/Index" asp-route-pagina="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-page="/Solicitudes/Index" asp-route-pagina="@(Model.PaginaActual + 1)" aria-label="Siguiente"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalConfirmarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalConfirmarEliminarLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2 fs-6">¿Realmente desea eliminar el elemento seleccionado?</p>
                <p class="text-muted small mb-0">Solicitud con consecutivo: <strong id="lblConsecutivoEliminar"></strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form method="post" asp-page-handler="Eliminar" id="formEliminar" class="d-inline">
                    <input type="hidden" name="id" id="inputEliminarId" value="" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Notificación de Error al Eliminar (Datos Relacionados) -->
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="modal fade" id="modalMensajeError" tabindex="-1" aria-labelledby="modalMensajeErrorLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="modalMensajeErrorLabel">
                        <i class="fas fa-exclamation-triangle me-2"></i>Atención
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="mb-3 text-danger">
                        <i class="fas fa-times-circle fa-3x"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">No se puede eliminar la solicitud</h5>
                    <p class="fs-6 text-muted mb-0">@Model.MensajeError</p>
                </div>
                <div class="modal-footer justify-content-center bg-light">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
}

</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/Solicitudes.css" asp-append-version="true" />
    <script>
        function confirmarEliminar(id, consecutivo) {
            document.getElementById('inputEliminarId').value = id;
            document.getElementById('lblConsecutivoEliminar').textContent = consecutivo;
            const modal = new bootstrap.Modal(document.getElementById('modalConfirmarEliminar'));
            modal.show();
        }

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                const modalErrorEl = document.getElementById('modalMensajeError');
                if (modalErrorEl) {
                    const modalError = new bootstrap.Modal(modalErrorEl);
                    modalError.show();
                }
            });
            </text>
        }
    </script>
}
