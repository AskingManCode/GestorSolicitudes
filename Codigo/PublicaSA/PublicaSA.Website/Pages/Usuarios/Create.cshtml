@page
@model PublicaSA.Website.Pages.Usuarios.CreateModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<!-- Encabezado -->
<div class="card border-0 shadow-sm mb-4 usuarios-header-card">
    <div class="card-body py-3">

        <!-- Botones circulares: Regresar / Guardar -->
        <div class="d-flex gap-2 mb-3">
            <a asp-page="Index"
               class="btn btn-accion rounded-circle"
               aria-label="Regresar al listado"
               title="Regresar">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
            </a>
            <button type="submit"
                    form="formUsuario"
                    class="btn btn-accion rounded-circle"
                    aria-label="Guardar usuario"
                    title="Guardar">
                <i class="fas fa-save" aria-hidden="true"></i>
            </button>
        </div>

    </div>
</div>

<!-- Card del formulario -->
<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <!-- Título -->
        <div class="mb-4 pb-3 border-bottom">
            <h5 class="fw-bold mb-0" style="color: #4e73df;">
                Formulario Usuario
            </h5>
        </div>

        <form id="formUsuario" method="post">
            <div class="row g-3">

                <!-- Nombre completo -->
                <div class="col-md-6">
                    <label asp-for="Usuario.NombreCompleto" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Nombre completo <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Usuario.NombreCompleto" class="form-control" maxlength="150" />
                </div>

                <!-- Correo -->
                <div class="col-md-6">
                    <label asp-for="Usuario.Correo" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Correo electrónico <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Usuario.Correo" class="form-control" maxlength="150" />
                </div>

                <!-- Nombre de usuario -->
                <div class="col-md-6">
                    <label asp-for="Usuario.NombreUsuario" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Nombre de usuario <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Usuario.NombreUsuario" class="form-control" maxlength="50" />
                </div>

                <!-- Contraseña -->
                <div class="col-md-6">
                    <label asp-for="Usuario.Contrasena" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Contraseña <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <input asp-for="Usuario.Contrasena" type="password" class="form-control" id="Contrasena" />
                        <button class="btn btn-outline-secondary" type="button" id="btnTogglePassword" title="Mostrar/Ocultar contraseña">
                            <i class="fas fa-eye" id="iconTogglePassword" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <!-- Estado -->
                <div class="col-md-6">
                    <label asp-for="Usuario.CodigoEstado" class="form-label fw-bold mb-1" style="color: #5a5c69; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Estado <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Usuario.CodigoEstado" class="form-select">
                        @foreach (var estado in Model.ListaEstados)
                        {
                            <option value="@estado.CodigoEstado"
                                    selected="@(estado.CodigoEstado == Model.EstadoActual)">
                                @estado.Nombre
                            </option>
                        }
                    </select>

                </div>

            </div>
        </form>
    </div>
</div>

<!-- Usamos el modal global definido en _Layout.cshtml -->

@section Scripts {
    <link rel="stylesheet" href="~/css/Usuarios.css" asp-append-version="true" />

    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/usuarios.js" asp-append-version="true"></script>

    @if (TempData["ModalMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarMensaje('@(TempData["ModalTitle"] ?? "Mensaje")', '@Html.Raw(TempData["ModalMessage"])', '@(TempData["ModalType"] ?? "info")');
            });
        </script>
    }
}