@page
@model PublicaSA.Website.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<!-- Bloque superior con borde azul -->
<div class="card border-0 shadow-sm mb-4 usuarios-header-card">
    <div class="card-body py-3">
        <h1 class="h5 fw-bold mb-3">
            Mantenimiento de Usuarios
        </h1>

        <a asp-page="Create" class="btn btn-sm btn-nuevo">
            <i class="fas fa-plus me-1"></i> Nuevo Usuario
        </a>
    </div>
</div>

<!-- Card de Información -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="h5 fw-bold" style="color: #4e73df;">
            Información
        </h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 usuarios-table">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="ps-4 col-id">ID</th>
                        <th scope="col">Nombre de usuario</th>
                        <th scope="col">Nombre completo</th>
                        <th scope="col" class="d-none d-md-table-cell">Correo</th>
                        <th scope="col" class="col-estado">Estado</th>
                        <th scope="col" class="text-end pe-4 col-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Fila 1 -->
                    <tr>
                        <td class="ps-4">1</td>
                        <td>sebasjarrieta</td>
                        <td>Sebastián Jiménez Arrieta</td>
                        <td>sebas.jimenez@publica.com</td>
                        <td>
                            <span class="badge rounded-pill text-bg-success">
                                <i class="fas fa-check-circle me-1" aria-hidden="true"></i>Activo
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2">
                                <!-- Cambiar estado -->
                                <div class="dropdown">
                                    <button class="btn btn-sm rounded-circle btn-accion dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-popper-config='{"strategy":"fixed"}'
                                            aria-expanded="false"
                                            aria-label="Cambiar estado de sebasjarrieta"
                                            title="Cambiar estado">
                                        <i class="fas fa-exchange-alt fa-sm" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <button class="dropdown-item active-state" type="button" disabled aria-current="true">
                                                <span class="badge rounded-pill text-bg-success me-2" aria-hidden="true">&nbsp;</span> Activar
                                                <i class="fas fa-check ms-auto" aria-hidden="true"></i>
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" type="button">
                                                <span class="badge rounded-pill text-bg-secondary me-2" aria-hidden="true">&nbsp;</span> Inactivar
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" type="button">
                                                <span class="badge rounded-pill text-bg-danger me-2" aria-hidden="true">&nbsp;</span> Bloquear
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                <!-- Editar -->
                                <a asp-page="Edit" asp-route-id="1" class="btn btn-sm rounded-circle btn-accion"
                                   aria-label="Editar sebasjarrieta" title="Editar">
                                    <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                </a>
                                <!-- Eliminar -->
                                <button type="button" class="btn btn-sm rounded-circle btn-accion"
                                        aria-label="Eliminar sebasjarrieta" title="Eliminar">
                                    <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Fila 2 -->
                    <tr>
                        <td class="ps-4">2</td>
                        <td>mlopez</td>
                        <td>María López Vargas</td>
                        <td>maria.lopez@publica.com</td>
                        <td>
                            <span class="badge rounded-pill text-bg-secondary">
                                <i class="fas fa-minus-circle me-1" aria-hidden="true"></i>Inactivo
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2">
                                <!-- Cambiar estado -->
                                <div class="dropdown">
                                    <button class="btn btn-sm rounded-circle btn-accion dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-popper-config='{"strategy":"fixed"}'
                                            aria-expanded="false"
                                            aria-label="Cambiar estado de sebasjarrieta"
                                            title="Cambiar estado">
                                        <i class="fas fa-exchange-alt fa-sm" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <button class="dropdown-item" type="button">
                                                <span class="badge rounded-pill text-bg-success me-2" aria-hidden="true">&nbsp;</span> Activar
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item active-state" type="button" disabled aria-current="true">
                                                <span class="badge rounded-pill text-bg-secondary me-2" aria-hidden="true">&nbsp;</span> Inactivar
                                                <i class="fas fa-check ms-auto" aria-hidden="true"></i>
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" type="button">
                                                <span class="badge rounded-pill text-bg-danger me-2" aria-hidden="true">&nbsp;</span> Bloquear
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                <!-- Editar -->
                                <a asp-page="Edit" asp-route-id="1" class="btn btn-sm rounded-circle btn-accion"
                                   aria-label="Editar sebasjarrieta" title="Editar">
                                    <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                </a>
                                <!-- Eliminar -->
                                <button type="button" class="btn btn-sm rounded-circle btn-accion"
                                        aria-label="Eliminar sebasjarrieta" title="Eliminar">
                                    <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Fila 3 -->
                    <tr>
                        <td class="ps-4">3</td>
                        <td>cadmin</td>
                        <td>Carlos Administrador</td>
                        <td>admin@publica.com</td>
                        <td>
                            <span class="badge rounded-pill text-bg-danger">
                                <i class="fas fa-ban me-1" aria-hidden="true"></i>Bloqueado
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-2">
                                <!-- Cambiar estado -->
                                <div class="dropdown">
                                    <button class="btn btn-sm rounded-circle btn-accion dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-popper-config='{"strategy":"fixed"}'
                                            aria-expanded="false"
                                            aria-label="Cambiar estado de sebasjarrieta"
                                            title="Cambiar estado">
                                        <i class="fas fa-exchange-alt fa-sm" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <button class="dropdown-item" type="button">
                                                <span class="badge rounded-pill text-bg-success me-2" aria-hidden="true">&nbsp;</span> Activar
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" type="button">
                                                <span class="badge rounded-pill text-bg-secondary me-2" aria-hidden="true">&nbsp;</span> Inactivar
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item active-state" type="button" disabled aria-current="true">
                                                <span class="badge rounded-pill text-bg-danger me-2" aria-hidden="true">&nbsp;</span> Bloquear
                                                <i class="fas fa-check ms-auto" aria-hidden="true"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                <!-- Editar -->
                                <a asp-page="Edit" asp-route-id="1" class="btn btn-sm rounded-circle btn-accion"
                                   aria-label="Editar sebasjarrieta" title="Editar">
                                    <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                </a>
                                <!-- Eliminar -->
                                <button type="button" class="btn btn-sm rounded-circle btn-accion"
                                        aria-label="Eliminar cadmin" title="Eliminar">
                                    <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación -->
<nav aria-label="Paginación de usuarios" class="mt-4">
    <ul class="pagination justify-content-end mb-0">
        <li class="page-item disabled">
            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                <i class="fas fa-chevron-left"></i>
            </a>
        </li>
        <li class="page-item active">
            <a class="page-link" href="#">1</a>
        </li>
        <li class="page-item">
            <a class="page-link" href="#">2</a>
        </li>
        <li class="page-item">
            <a class="page-link" href="#">3</a>
        </li>
        <li class="page-item">
            <a class="page-link" href="#">
                <i class="fas fa-chevron-right"></i>
            </a>
        </li>
    </ul>
</nav> 

@section Scripts {
    <link rel="stylesheet" href="~/css/Usuarios.css" asp-append-version="true" />
}