@page
@model PublicaSA.Website.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<!-- Bloque superior con borde azul -->
<div class="card border-0 shadow-sm mb-4 usuarios-header-card">
    <div class="card-body py-3">
        <h1 class="h5 fw-bold mb-3">
            Mantenimiento de Usuarios
        </h1>

        <a asp-page="Create" class="btn btn-sm btn-nuevo">
            <i class="fas fa-file me-1"></i> Nuevo Usuario
        </a>
    </div>
</div>

<!-- Card de Información -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="h5 fw-bold" style="color: #4e73df;">
            Información
        </h5>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 usuarios-table">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="ps-4 col-id">ID</th>
                        <th scope="col">Nombre de usuario</th>
                        <th scope="col">Nombre completo</th>
                        <th scope="col" class="d-none d-md-table-cell">Correo</th>
                        <th scope="col" class="col-estado">Estado</th>
                        <th scope="col" class="text-end pe-4 col-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ListaUsuarios.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No hay usuarios registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var usuario in Model.ListaUsuarios)
                        {
                            // Determinar clases del badge según el estado
                            var badgeClass = usuario.Estado.ToUpper() switch
                            {
                                "ACTIVO" => "text-bg-success",
                                "INACTIVO" => "text-bg-secondary",
                                "BLOQUEADO" => "text-bg-danger",
                                _ => "text-bg-secondary"
                            };
                            var iconClass = usuario.Estado.ToUpper() switch
                            {
                                "ACTIVO" => "fa-check-circle",
                                "INACTIVO" => "fa-minus-circle",
                                "BLOQUEADO" => "fa-ban",
                                _ => "fa-question-circle"
                            };

                            <tr>
                                <td class="ps-4">@usuario.IdUsuario</td>
                                <td>@usuario.NombreUsuario</td>
                                <td>@usuario.NombreCompleto</td>
                                <td class="d-none d-md-table-cell">@usuario.Correo</td>
                                <td>
                                    <span class="badge rounded-pill @badgeClass">
                                        <i class="fas @iconClass me-1" aria-hidden="true"></i>@usuario.Estado
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Cambiar estado -->
                                        <div class="dropdown">
                                            <button class="btn btn-sm rounded-circle btn-accion dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    data-bs-boundary="viewport"
                                                    aria-expanded="false"
                                                    title="Cambiar estado">
                                                <i class="fas fa-exchange-alt fa-sm" aria-hidden="true"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                @foreach (var estado in Model.ListaEstados)
                                                {
                                                    var estadoBadge = estado.CodigoEstado switch
                                                    {
                                                        "ACTIVO" => "text-bg-success",
                                                        "INACTIVO" => "text-bg-secondary",
                                                        "BLOQUEADO" => "text-bg-danger",
                                                        _ => "text-bg-secondary"
                                                    };
                                                    var isActive = estado.Nombre.Equals(usuario.Estado, StringComparison.OrdinalIgnoreCase);
            
                                                    <li>
                                                        <form method="post" asp-page-handler="CambiarEstado" class="d-inline">
                                                            <input type="hidden" name="idUsuario" value="@usuario.IdUsuario" />
                                                            <input type="hidden" name="codigoEstado" value="@estado.CodigoEstado" />
                                                            <button class="dropdown-item @(isActive ? "active-state" : "")" 
                                                                    type="submit" 
                                                                    disabled="@isActive"
                                                                    aria-current="@(isActive ? "true" : null)">
                                                                <span class="badge rounded-pill @estadoBadge me-2">&nbsp;</span>
                                                                @estado.Nombre
                                                                @if (isActive)
                                                                {
                                                                    <i class="fas fa-check ms-auto" aria-hidden="true"></i>
                                                                }
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        <!-- Editar -->
                                        <a asp-page="Edit" asp-route-id="@usuario.IdUsuario" 
                                           class="btn btn-sm rounded-circle btn-accion"
                                           aria-label="Editar @usuario.NombreUsuario" title="Editar">
                                            <i class="fas fa-pencil-alt fa-sm" aria-hidden="true"></i>
                                        </a>
                                        <!-- Eliminar -->
                                        <button type="button" 
                                                class="btn btn-sm rounded-circle btn-accion"
                                                data-bs-toggle="modal" 
                                                data-bs-target="#modalEliminar"
                                                data-id="@usuario.IdUsuario"
                                                data-nombre="@usuario.NombreUsuario"
                                                aria-label="Eliminar @usuario.NombreUsuario" title="Eliminar">
                                            <i class="fas fa-trash-alt fa-sm" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginación compacta -->
@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación de usuarios" class="mt-3">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pagina="@(Model.PaginaActual - 1)" 
                   aria-label="Anterior">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
            
            @for (int i = Math.Max(1, Model.PaginaActual - 2); i <= Math.Min(Model.TotalPaginas, Model.PaginaActual + 2); i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-pagina="@i">@i</a>
                </li>
            }
            
            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pagina="@(Model.PaginaActual + 1)" 
                   aria-label="Siguiente">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <link rel="stylesheet" href="~/css/Usuarios.css" asp-append-version="true" />
    <script src="~/js/usuarios.js" asp-append-version="true"></script>

    @if (Model.ShowSuccess)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                mostrarMensaje('Éxito', '@Html.Raw(Model.SuccessMessage ?? "")', 'success');
            });
        </script>
    }
}