@page "{id:int}"
@model PublicaSA.WebPresentation.Pages.Solicitudes.EditarModel
@{
    ViewData["Title"] = "Editar Solicitud";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Editar Solicitud</h1>
            <p class="text-muted small mb-0">Modifique los datos de la solicitud @Model.Input.ConsecutivoOficio</p>
        </div>
        <a asp-page="/Solicitudes/Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
            <i class="fas fa-arrow-left"></i>
            <span>Regresar al listado</span>
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-bold text-primary">Formulario de Edición</h6>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" asp-for="Input.IdSolicitud" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.ConsecutivoOficio" class="form-label fw-semibold">
                            Consecutivo de Oficio <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.ConsecutivoOficio" class="form-control" />
                        <span asp-validation-for="Input.ConsecutivoOficio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Titulo" class="form-label fw-semibold">
                            Título de la Solicitud <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Titulo" class="form-control" />
                        <span asp-validation-for="Input.Titulo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.IdRepresentante" class="form-label fw-semibold">
                            Representante <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Input.IdRepresentante" asp-items="Model.RepresentantesSelectList" class="form-select">
                            <option value="">-- Seleccione un representante --</option>
                        </select>
                        <span asp-validation-for="Input.IdRepresentante" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.IdEstado" class="form-label fw-semibold">
                            Estado de la Solicitud <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Input.IdEstado" asp-items="Model.EstadosSelectList" class="form-select">
                        </select>
                        <span asp-validation-for="Input.IdEstado" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Input.FechaIngreso" class="form-label fw-semibold">
                            Fecha de Ingreso <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.FechaIngreso" type="date" class="form-control" />
                        <span asp-validation-for="Input.FechaIngreso" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Input.FechaInicio" class="form-label fw-semibold">
                            Fecha de Inicio
                        </label>
                        <input asp-for="Input.FechaInicio" type="date" class="form-control" />
                        <span asp-validation-for="Input.FechaInicio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Input.FechaRespuesta" class="form-label fw-semibold">
                            Fecha de Respuesta
                        </label>
                        <input asp-for="Input.FechaRespuesta" type="date" class="form-control" />
                        <span asp-validation-for="Input.FechaRespuesta" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.DocumentoInicio" class="form-label fw-semibold">
                            Documento de Inicio
                        </label>
                        <input asp-for="Input.DocumentoInicio" class="form-control" />
                        <span asp-validation-for="Input.DocumentoInicio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.DocumentoRespuesta" class="form-label fw-semibold">
                            Documento de Respuesta
                        </label>
                        <input asp-for="Input.DocumentoRespuesta" class="form-control" />
                        <span asp-validation-for="Input.DocumentoRespuesta" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Descripcion" class="form-label fw-semibold">Descripción</label>
                        <textarea asp-for="Input.Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Input.Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Observaciones" class="form-label fw-semibold">Observaciones</label>
                        <textarea asp-for="Input.Observaciones" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Input.Observaciones" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="/Solicitudes/Index" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Salvar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
