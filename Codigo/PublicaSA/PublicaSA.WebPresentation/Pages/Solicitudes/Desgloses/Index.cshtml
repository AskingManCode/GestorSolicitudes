@page
@model PublicaSA.WebPresentation.Pages.Solicitudes.Desgloses.IndexModel
@{
    ViewData["Title"] = "Desglose de Solicitud";
}

<div class="container-fluid px-0">
    <!-- Encabezado con datos de la solicitud padre -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary fs-6">@Model.Solicitud?.ConsecutivoOficio</span>
                        <h4 class="mb-0 fw-bold text-gray-800">@Model.Solicitud?.Titulo</h4>
                    </div>
                    <div class="text-muted small">
                        <span><strong>Representante:</strong> @Model.Solicitud?.NombreRepresentante</span> |
                        <span><strong>Estado:</strong> @Model.Solicitud?.NombreEstado</span> |
                        <span><strong>Fecha Ingreso:</strong> @Model.Solicitud?.FechaIngreso.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-page="/Solicitudes/Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Regresar a Solicitudes
                    </a>
                    <a asp-page="/Solicitudes/Desgloses/Crear" asp-route-idSolicitud="@Model.IdSolicitud" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Nuevo Desglose
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- Tabla de Desgloses -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">Detalle mensual de costos y horas</h6>
            <span class="badge bg-secondary">Total registros: @Model.TotalRegistros</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Mes</th>
                            <th scope="col">Año</th>
                            <th scope="col" class="text-end">Horas</th>
                            <th scope="col" class="text-end">Monto</th>
                            <th scope="col" class="text-end">IVA (13%)</th>
                            <th scope="col" class="text-end">Total</th>
                            <th scope="col" class="text-center">% Cobro</th>
                            <th scope="col">Observaciones</th>
                            <th scope="col" class="text-center" style="min-width: 160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Desgloses != null && Model.Desgloses.Any())
                        {
                            @foreach (var item in Model.Desgloses)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.NombreMes</td>
                                    <td>@item.Anio</td>
                                    <td class="text-end">@item.Horas.ToString("N2")</td>
                                    <td class="text-end">₡@item.Monto.ToString("N2")</td>
                                    <td class="text-end text-muted">₡@item.Iva.ToString("N2")</td>
                                    <td class="text-end fw-bold text-primary">₡@item.Total.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">@item.PorcentajeCobro%</span>
                                    </td>
                                    <td class="small text-muted text-truncate" style="max-width: 200px;" title="@item.Observaciones">
                                        @(string.IsNullOrWhiteSpace(item.Observaciones) ? "-" : item.Observaciones)
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="/Solicitudes/Desgloses/Editar" asp-route-id="@item.IdDesglose" class="btn btn-outline-primary" title="Editar">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" 
                                                    onclick="confirmarEliminarDesglose(@item.IdDesglose, '@item.NombreMes', @item.Anio)" 
                                                    title="Eliminar">
                                                <i class="fas fa-trash-alt"></i> Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="fas fa-clipboard-list fa-2x mb-2 d-block"></i>
                                    No hay desgloses registrados para esta solicitud.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginación (Máximo 10 elementos por página) -->
        @if (Model.TotalPaginas > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <div class="small text-muted">
                    Página @Model.PaginaActual de @Model.TotalPaginas (Mostrando máximo 10 elementos por página)
                </div>
                <nav aria-label="Navegación de desgloses">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Solicitudes/Desgloses/Index" asp-route-idSolicitud="@Model.IdSolicitud" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-page="/Solicitudes/Desgloses/Index" asp-route-idSolicitud="@Model.IdSolicitud" asp-route-pagina="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-page="/Solicitudes/Desgloses/Index" asp-route-idSolicitud="@Model.IdSolicitud" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="modalEliminarDesglose" tabindex="-1" aria-labelledby="modalEliminarDesgloseLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminarDesgloseLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2 fs-6">¿Realmente desea eliminar el elemento seleccionado?</p>
                <p class="text-muted small mb-0">Desglose correspondiente a: <strong id="lblDesgloseDetalle"></strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form method="post" asp-page-handler="Eliminar" id="formEliminarDesglose" class="d-inline">
                    <input type="hidden" name="id" id="inputEliminarDesgloseId" value="" />
                    <input type="hidden" name="idSolicitud" value="@Model.IdSolicitud" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Notificación de Error al Eliminar (Datos Relacionados) -->
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="modal fade" id="modalMensajeErrorDesglose" tabindex="-1" aria-labelledby="modalMensajeErrorDesgloseLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="modalMensajeErrorDesgloseLabel">
                        <i class="fas fa-exclamation-triangle me-2"></i>Atención
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="mb-3 text-danger">
                        <i class="fas fa-times-circle fa-3x"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">No se puede eliminar el desglose</h5>
                    <p class="fs-6 text-muted mb-0">@Model.MensajeError</p>
                </div>
                <div class="modal-footer justify-content-center bg-light">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Aceptar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmarEliminarDesglose(id, mes, anio) {
            document.getElementById('inputEliminarDesgloseId').value = id;
            document.getElementById('lblDesgloseDetalle').textContent = mes + ' ' + anio;
            const modal = new bootstrap.Modal(document.getElementById('modalEliminarDesglose'));
            modal.show();
        }

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                const modalErrorEl = document.getElementById('modalMensajeErrorDesglose');
                if (modalErrorEl) {
                    const modalError = new bootstrap.Modal(modalErrorEl);
                    modalError.show();
                }
            });
            </text>
        }
    </script>
}
