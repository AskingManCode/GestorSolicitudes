@page
@model PublicaSA.WebPresentation.Pages.Solicitudes.Reportes.MontosPorMesModel

@{
    ViewData["Title"] = "Montos por mes";
}

<h1>Montos por mes</h1>

@* Envía el mes y año para generar el reporte. *@
<form method="post" class="mb-4">
    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Entrada.Mes" class="form-label">
                Mes
            </label>
            <select asp-for="Entrada.Mes" class="form-select">
                <option value="">Seleccione el mes</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>
            <span asp-validation-for="Entrada.Mes"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Entrada.Anio" class="form-label">
                Año
            </label>
            <input asp-for="Entrada.Anio"
                   type="number"
                   min="1"
                   max="65535"
                   step="1"
                   class="form-control" />
            <span asp-validation-for="Entrada.Anio"
                  class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Generar reporte
    </button>
</form>

@if (Model.Reporte is not null)
{
    @* Presenta los datos del período y las sumas calculadas por el servicio. *@
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Consecutivo del oficio</th>
                    <th>Título de la solicitud</th>
                    <th>Mes</th>
                    <th>Año</th>
                    <th class="text-end">Monto</th>
                    <th class="text-end">IVA</th>
                    <th class="text-end">Total por solicitud</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitud in Model.Reporte.Solicitudes)
                {
                    <tr>
                        <td>@solicitud.ConsecutivoOficio</td>
                        <td>@solicitud.Titulo</td>
                        <td>@solicitud.Mes</td>
                        <td>@solicitud.Anio</td>
                        <td class="text-end">
                            @solicitud.Monto.ToString("N2")
                        </td>
                        <td class="text-end">
                            @solicitud.Iva.ToString("N2")
                        </td>
                        <td class="text-end">
                            @solicitud.Total.ToString("N2")
                        </td>
                    </tr>
                }

                @if (!Model.Reporte.Solicitudes.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No hay datos para el mes y año seleccionados.
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4">Totales generales</td>
                    <td class="text-end">
                        @Model.Reporte.TotalMonto.ToString("N2")
                    </td>
                    <td class="text-end">
                        @Model.Reporte.TotalIva.ToString("N2")
                    </td>
                    <td class="text-end">
                        @Model.Reporte.TotalGeneral.ToString("N2")
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}