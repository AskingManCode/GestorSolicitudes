@page
@model PublicaSA.WebPresentation.Pages.Solicitudes.IndexModel
@{
    ViewData["Title"] = "Mantenimiento de Solicitudes";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Administración de Solicitudes</h1>
            <p class="text-muted small mb-0">Gestión y control de solicitudes registradas en el sistema</p>
        </div>
        <a asp-page="/Solicitudes/Crear" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="fas fa-plus"></i>
            <span>Nuevo</span>
        </a>
    </div>

    <!-- Alertas de mensajes -->
    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @Model.MensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Leyenda de colores del semáforo -->
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center gap-3 small">
                <span class="fw-bold text-secondary">Semáforo de estado:</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="fas fa-circle me-1 small"></i> Nueva
                </span>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                    <i class="fas fa-circle me-1 small"></i> Vence hoy (5 días hábiles)
                </span>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                    <i class="fas fa-circle me-1 small"></i> Vencida (Más de 5 días hábiles sin respuesta)
                </span>
            </div>
        </div>
    </div>

    <!-- Tabla de Solicitudes -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">Listado de Solicitudes</h6>
            <span class="badge bg-secondary">Total: @Model.TotalRegistros</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Consecutivo</th>
                            <th scope="col">Título</th>
                            <th scope="col">Representante</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Fecha Ingreso</th>
                            <th scope="col">Fecha Respuesta</th>
                            <th scope="col">Fecha Inicio</th>
                            <th scope="col" class="text-center" style="min-width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Solicitudes != null && Model.Solicitudes.Any())
                        {
                            @foreach (var item in Model.Solicitudes)
                            {
                                var semaforoClase = item.SemaforoColor;
                                <tr class="@semaforoClase">
                                    <td class="fw-semibold">@item.ConsecutivoOficio</td>
                                    <td>@item.Titulo</td>
                                    <td>
                                        <div class="text-dark">@item.NombreRepresentante</div>
                                        <small class="text-muted">@item.EmailRepresentante</small>
                                    </td>
                                    <td>
                                        @if (item.NombreEstado == "Vencida" || semaforoClase == "table-danger")
                                        {
                                            <span class="badge bg-danger">@item.EstadoSemaforoEtiqueta</span>
                                        }
                                        else if (semaforoClase == "table-warning")
                                        {
                                            <span class="badge bg-warning text-dark">@item.EstadoSemaforoEtiqueta</span>
                                        }
                                        else if (item.NombreEstado == "Nueva")
                                        {
                                            <span class="badge bg-success">@item.NombreEstado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">@item.NombreEstado</span>
                                        }
                                    </td>
                                    <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td>@(item.FechaRespuesta.HasValue ? item.FechaRespuesta.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    <td>@(item.FechaInicio.HasValue ? item.FechaInicio.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="/Solicitudes/Editar" asp-route-id="@item.IdSolicitud" class="btn btn-outline-primary" title="Editar">
                                                <i class="fas fa-edit"></i> Editar
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" 
                                                    onclick="confirmarEliminar(@item.IdSolicitud, '@item.ConsecutivoOficio')" 
                                                    title="Eliminar">
                                                <i class="fas fa-trash-alt"></i> Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                    No se encontraron solicitudes registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Paginación (Máximo 5 elementos por página) -->
        @if (Model.TotalPaginas > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <div class="small text-muted">
                    Página @Model.PaginaActual de @Model.TotalPaginas (Mostrando máximo 5 solicitudes por página)
                </div>
                <nav aria-label="Navegación de páginas">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Solicitudes/Index" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                <a class="page-link" asp-page="/Solicitudes/Index" asp-route-pagina="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link" asp-page="/Solicitudes/Index" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="modalConfirmarEliminar" tabindex="-1" aria-labelledby="modalConfirmarEliminarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalConfirmarEliminarLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-2 fs-6">¿Realmente desea eliminar el elemento seleccionado?</p>
                <p class="text-muted small mb-0">Solicitud con consecutivo: <strong id="lblConsecutivoEliminar"></strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form method="post" asp-page-handler="Eliminar" id="formEliminar" class="d-inline">
                    <input type="hidden" name="id" id="inputEliminarId" value="" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmarEliminar(id, consecutivo) {
            document.getElementById('inputEliminarId').value = id;
            document.getElementById('lblConsecutivoEliminar').textContent = consecutivo;
            const modal = new bootstrap.Modal(document.getElementById('modalConfirmarEliminar'));
            modal.show();
        }
    </script>
}
