@page
@model PublicaSA.WebPresentation.Pages.Tareas.IndexModel

@{
    ViewData["Title"] = "Tareas de la solicitud";
}

<h1>Tareas de la solicitud</h1>

<p>Solicitud: @Model.IdSolicitud</p>

@* Muestra el resultado de las operaciones después de regresar al listado. *@
@if (TempData["Exito"] is string mensajeExito)
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

@if (TempData["Error"] is string mensajeError)
{
    <div class="alert alert-danger" role="alert">
        @mensajeError
    </div>
}

@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">
        @Model.Error
    </div>
}
else
{
    <a asp-page="./Nuevo"
       asp-route-idSolicitud="@Model.IdSolicitud"
       class="btn btn-primary mb-3">
        Nuevo
    </a>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Horas invertidas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tarea in Model.Tareas)
                {
                    <tr>
                        <td>@tarea.Descripcion</td>
                        <td>@tarea.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@tarea.IdUsuario</td>
                        <td>@tarea.HorasInvertidas.ToString("0.00")</td>
                        <td>
                            <a asp-page="./Editar"
                               asp-route-idTarea="@tarea.IdTarea"
                               asp-route-idSolicitud="@Model.IdSolicitud"
                               class="btn btn-primary btn-sm">
                                Editar
                            </a>

                            @* Abre la confirmación sin eliminar todavía. *@
                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#confirmarEliminar"
                                    data-id-tarea="@tarea.IdTarea">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }

                @if (!Model.Tareas.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            No hay tareas en esta página.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Conserva la solicitud seleccionada al cambiar de página. *@
    <nav aria-label="Paginación de tareas">
        <ul class="pagination">
            @if (Model.Pagina > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-idSolicitud="@Model.IdSolicitud"
                       asp-route-pagina="@(Model.Pagina - 1)">
                        Anterior
                    </a>
                </li>
            }

            <li class="page-item disabled">
                <span class="page-link">
                    Página @Model.Pagina
                </span>
            </li>

            @if (Model.Pagina < Model.TotalPaginas)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-idSolicitud="@Model.IdSolicitud"
                       asp-route-pagina="@(Model.Pagina + 1)">
                        Siguiente
                    </a>
                </li>
            }
        </ul>
    </nav>

    @* Solo la opción Sí envía la petición de eliminación. *@
    <div class="modal fade"
         id="confirmarEliminar"
         tabindex="-1"
         aria-labelledby="tituloEliminar"
         aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="tituloEliminar">
                        Confirmar eliminación
                    </h2>
                </div>

                <div class="modal-body">
                    ¿Realmente desea eliminar el elemento seleccionado?
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        No
                    </button>

                    <form method="post" asp-page-handler="Eliminar">
                        <input type="hidden"
                               name="idSolicitud"
                               value="@Model.IdSolicitud" />

                        <input type="hidden"
                               name="idTarea"
                               id="idTareaEliminar" />

                        <button type="submit" class="btn btn-danger">
                            Sí
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Coloca en el formulario el identificador de la tarea seleccionada.
        const modalEliminar = document.getElementById('confirmarEliminar');

        if (modalEliminar) {
            modalEliminar.addEventListener('show.bs.modal', function (evento) {
                const boton = evento.relatedTarget;

                document.getElementById('idTareaEliminar').value =
                    boton.getAttribute('data-id-tarea');
            });
        }
    </script>
}