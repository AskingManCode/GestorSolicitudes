<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pública S.A.</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
</head>
<body>

    <div class="d-flex" id="wrapper">

        <!-- SIDEBAR -->
        <div id="sidebar-wrapper" class="bg-sidebar">

            <!-- Brand -->
            <div class="sidebar-heading text-white d-flex align-items-center px-3 py-3">
                <div class="sidebar-brand-icon me-3">
                    <img src="~/images/logo.png" alt="Logo" class="logo-img" />
                </div>
                <div class="sidebar-brand-text fw-bold">Pública S.A.</div>
            </div>

            <!-- Menú -->
            <div class="list-group list-group-flush pt-2">

                <a asp-page="/Usuarios/Usuarios" class="list-group-item list-group-item-action bg-sidebar text-white">
                    <i class="fas fa-users fa-fw"></i>
                    <span class="sidebar-text">Usuarios</span>
                </a>

                <!-- Solicitudes -->
                @{
                    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                    var isSolicitudes = currentPage.StartsWith("/Solicitudes", StringComparison.OrdinalIgnoreCase);
                }
                <a class="list-group-item list-group-item-action bg-sidebar text-white d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#collapseSolicitudes" role="button" aria-expanded="@(isSolicitudes ? "true" : "false")">
                    <span>
                        <i class="fas fa-file-alt fa-fw"></i>
                        <span class="sidebar-text">Solicitudes</span>
                    </span>
                    <i class="fas fa-chevron-down small sidebar-text"></i>
                </a>

                <div class="collapse @(isSolicitudes ? "show" : "")" id="collapseSolicitudes">
                    <a asp-page="/Solicitudes/Index" class="list-group-item list-group-item-action bg-sidebar-submenu text-white ps-5 @(currentPage.Equals("/Solicitudes/Index", StringComparison.OrdinalIgnoreCase) ? "active fw-bold" : "")">
                        <span class="sidebar-text">Listado</span>
                    </a>
                    <a asp-page="/Solicitudes/Representantes/Index" class="list-group-item list-group-item-action bg-sidebar-submenu text-white ps-5">
                        <span class="sidebar-text">Representantes</span>
                    </a>
                    <a asp-page="/Solicitudes/Estados/Index" class="list-group-item list-group-item-action bg-sidebar-submenu text-white ps-5">
                        <span class="sidebar-text">Estados</span>
                    </a>
                    <a asp-page="/Solicitudes/Reportes/MontosPorMes" class="list-group-item list-group-item-action bg-sidebar-submenu text-white ps-5">
                        <span class="sidebar-text">Reportes</span>
                    </a>
                </div>

                <!-- Tareas -->
                <a class="list-group-item list-group-item-action bg-sidebar text-white d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#collapseTareas" role="button">
                    <span>
                        <i class="fas fa-tasks fa-fw"></i>
                        <span class="sidebar-text">Tareas</span>
                    </span>
                    <i class="fas fa-chevron-down small sidebar-text"></i>
                </a>

                <div class="collapse" id="collapseTareas">
                    <a asp-page="/Tareas/Index" class="list-group-item list-group-item-action bg-sidebar-submenu text-white ps-5">
                        <span class="sidebar-text">Listado</span>
                    </a>
                    <a asp-page="/Tareas/Reportes/PorUsuario" class="list-group-item list-group-item-action bg-sidebar-submenu text-white ps-5">
                        <span class="sidebar-text">Por Usuario</span>
                    </a>
                    <a asp-page="/Tareas/Reportes/PorSolicitud" class="list-group-item list-group-item-action bg-sidebar-submenu text-white ps-5">
                        <span class="sidebar-text">Por Solicitud</span>
                    </a>
                </div>

            </div>

            <!-- Botón inferior para colapsar -->
            <div class="sidebar-footer text-center py-3">
                <button class="btn btn-sm btn-light rounded-circle" id="sidebarToggle" title="Ocultar/Mostrar menú">
                    <i class="fas fa-angle-left" id="sidebarToggleIcon"></i>
                </button>
            </div>
        </div>
        <!-- FIN SIDEBAR -->

        <!-- Contenido -->
        <div id="page-content-wrapper">

            <!-- Topbar -->
            <nav class="navbar navbar-expand navbar-light bg-white border-bottom shadow-sm">
                <div class="container-fluid">
                    
                    <div></div>

                    <!-- Avatar + Nombre -->
                    <div class="d-flex align-items-center ms-auto">
                        <span class="fw-semibold text-secondary me-2">
                            <!-- @User.Identity?.Name -->
                            Nombre del Usuario
                        </span>
                        <img src="~/images/avatar-default.png"
                             alt="Avatar"
                             class="topbar-avatar" />
                    </div>

                </div>
            </nav>

            <!-- Body -->
            <div class="container-fluid px-4 py-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.getElementById("sidebarToggle")?.addEventListener("click", function (e) {
            e.preventDefault();
            document.body.classList.toggle("sidebar-toggled");

            const icon = document.getElementById("sidebarToggleIcon");
            if (icon) {
                icon.classList.toggle("fa-angle-left");
                icon.classList.toggle("fa-angle-right");
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>